# Demo Build of Sible - Lightweight Ansible Orchestrator
# This Dockerfile builds a demo version with fake data and no SSH access.
#
# Key differences from production Dockerfile:
#   - Uses requirements-demo.txt (no ansible-core, ansible-lint, asyncssh, numpy)
#   - No gcc/build-essential (all deps are pure Python wheels)
#   - SIBLE_DEMO_MODE=true baked in
#   - No SSH client needed

FROM python:3.11-slim

# Demo GHCR Metadata & OCI Labels
LABEL org.opencontainers.image.source="https://github.com/adam-benyekkou/Sible" \
      org.opencontainers.image.description="Sible Demo - Lightweight Ansible Orchestrator (Demo Version)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.authors="cavy.protocol.dev@proton.me" \
      org.opencontainers.image.title="Sible Demo" \
      org.opencontainers.image.vendor="Cavy Protocol" \
      org.opencontainers.image.version="demo-latest"

# Minimal runtime deps — only curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root system user for security
RUN groupadd -g 1000 sible && \
    useradd -u 1000 -g sible -m -s /bin/bash sible

WORKDIR /app

# Install Python deps from the lean demo requirements (pure-Python wheels only)
COPY requirements-demo.txt .
RUN pip install --no-cache-dir -r requirements-demo.txt

# Copy application source code with correct ownership
COPY --chown=sible:sible . .

# Ensure necessary directories exist with correct permissions
RUN mkdir -p /app/infrastructure /data/sible && chown -R sible:sible /app/infrastructure /data

# DEMO MODE: Enable demo mode by default
ENV SIBLE_DEMO_MODE=true
ENV SIBLE_SECRET_KEY=demo-secret-key-for-testing-only

# Environment Branding
ENV SIBLE_THEME_LIGHT="Geist Light"
ENV SIBLE_THEME_DARK="Catppuccin Dark"

# Healthcheck for container reliability
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

# Switch to non-root user
USER sible

# In Demo Mode, wipe the DB on every container start to guarantee a clean slate
CMD ["sh", "-c", "rm -f /data/sible.db && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
